    TurkLocalization: Oyun Sesi
  - Key: VolumeMusic
    RusLocalization: "\u0413\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u044C \u043C\u0443\u0437\u044B\u043A\u0438"
    EngLocalization: Volume music
