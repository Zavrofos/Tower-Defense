    TurkLocalization: Dil
  - Key: Loading
    RusLocalization: "\u0417\u0430\u0433\u0440\u0443\u0437\u043A\u0430 . . ."
    EngLocalization: Loading . . .
    TurkLocalization: "Y\u00FCkleniyor . . ."
  - Key: Buy
    RusLocalization: "\u041A\u0443\u043F\u0438\u0442\u044C"
    EngLocalization: Buy
    TurkLocalization: "Sat\u0131n Al"
  - Key: Purchased
    RusLocalization: "\u041A\u0443\u043F\u043B\u0435\u043D\u043E"
    EngLocalization: Buyed
    TurkLocalization: "Sat\u0131n Al\u0131nd\u0131"
  LocalizationBoxesGlobalShopItems:
  - Key: SimpleGun
    RusLocalization: "\u041F\u0440\u043E\u0441\u0442\u0430\u044F \u043F\u0443\u0448\u043A\u0430"
    EngLocalization: Simple Gun
    TurkLocalization: Basit Top
  - Key: SimpleCannonDescription
    RusLocalization: "\u041F\u0440\u043E\u0441\u0442\u0430\u044F \u043F\u0443\u0448\u043A\u0430,
      \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0430\u044F,
      \u0443\u0440\u043E\u043D \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439.
      \u0417\u0430 \u0441\u0447\u0435\u0442 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430
      \u043F\u0443\u0448\u043A\u0438 \u043F\u043E \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u0438
      \u043C\u043E\u0436\u0435\u0442 \u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C
      \u043F\u043E \u043B\u0435\u0442\u0430\u044E\u0449\u0438\u043C \u0432\u0440\u0430\u0433\u0430\u043C\n\n\u0412\u0440\u0430\u0433\u0438:
      \u041D\u0430\u0437\u0435\u043C\u043D\u044B\u0435, \u043B\u0435\u0442\u0430\u044E\u0449\u0438\u0435"
    EngLocalization: 'Simple Cannon, slow reload, low damage. Can rotate vertically
      to shoot at flying enemies.


      Enemies: Ground, Flying'
    TurkLocalization: "Basit Top, yava\u015F yeniden y\u00FCkleme, d\u00FC\u015F\u00FCk
      hasar. Dikey d\u00F6n\u00FC\u015F sayesinde u\u00E7an d\u00FC\u015Fmanlara ate\u015F
      edebilir.\n\nD\u00FC\u015Fmanlar: Kara, Hava"
  - Key: SimpleCannonUpgrade
    RusLocalization: "\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435 \u0434\u043B\u044F
      \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u043F\u0443\u0448\u043A\u0438"
    EngLocalization: Simple Cannon Upgrade
    TurkLocalization: "Basit Top Y\u00FCkseltmesi"
  - Key: SimpleCannonUpgradeDescription
    RusLocalization: "\u041F\u0440\u043E\u0441\u0442\u0430\u044F \u043F\u0443\u0448\u043A\u0430,
      \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0430\u044F,
      \u0443\u0440\u043E\u043D \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439.
      \u0417\u0430 \u0441\u0447\u0435\u0442 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430
      \u043F\u0443\u0448\u043A\u0438 \u043F\u043E \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u0438
      \u043C\u043E\u0436\u0435\u0442 \u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C
      \u043F\u043E \u043B\u0435\u0442\u0430\u044E\u0449\u0438\u043C \u0432\u0440\u0430\u0433\u0430\u043C\n\n\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435:
      \u041D\u0430\u043D\u043E\u0441\u0438\u0442 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0443\u0440\u043E\u043D\u0430 \u0437\u0430 \u0441\u0447\u0435\u0442 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u044F
      \u0441\u043D\u0430\u0440\u044F\u0434\u0430.  \n\n\u0412\u0440\u0430\u0433\u0438:
      \u041D\u0430\u0437\u0435\u043C\u043D\u044B\u0435, \u043B\u0435\u0442\u0430\u044E\u0449\u0438\u0435 "
    EngLocalization: 'Simple Cannon, slow reload, low damage. Can rotate vertically
      to shoot at flying enemies.


      Upgrade: Deals more damage by increasing
      projectile size.


      Enemies: Ground, Flying'
    TurkLocalization: "Basit Top, yava\u015F yeniden y\u00FCkleme, d\u00FC\u015F\u00FCk
      hasar. Dikey d\u00F6n\u00FC\u015F sayesinde u\u00E7an d\u00FC\u015Fmanlara ate\u015F
      edebilir.\n\nY\u00FCkseltme: Mermi boyutunu art\u0131rarak daha fazla hasar verir.\n\nD\u00FC\u015Fmanlar:
      Kara, Hava"
  - Key: MediumCannon
    RusLocalization: "\u0421\u0440\u0435\u0434\u043D\u044F\u044F \u043F\u0443\u0448\u043A\u0430"
    EngLocalization: Medium Cannon
    TurkLocalization: Orta Top
  - Key: MediumCannonDescription
    RusLocalization: "\u0421\u0442\u0440\u0435\u043B\u044F\u0435\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435
      \u0447\u0435\u043C \u043E\u0431\u044B\u0447\u043D\u0430\u044F\n\n\u0412\u0440\u0430\u0433\u0438:
      \u041D\u0430\u0437\u0435\u043C\u043D\u044B\u0435"
    EngLocalization: 'Fires faster than the Simple Cannon.


      Enemies: Ground'
    TurkLocalization: "Basit Toptan daha h\u0131zl\u0131 ate\u015F eder.\n\nD\u00FC\u015Fmanlar:
      Kara"
  - Key: MediumCannonUpgrade
    RusLocalization: "\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435 \u0434\u043B\u044F
      \u0441\u0440\u0435\u0434\u043D\u0435\u0439 \u043F\u0443\u0448\u043A\u0438"
    EngLocalization: Medium Cannon Upgrade
    TurkLocalization: "Orta Top Y\u00FCkseltmesi"
  - Key: MediumCannonUpgradeDescription
    RusLocalization: "\u0421\u0442\u0440\u0435\u043B\u044F\u0435\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435
      \u0447\u0435\u043C \u043E\u0431\u044B\u0447\u043D\u0430\u044F.\n \n\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435:
      \u041D\u0430\u043D\u043E\u0441\u0438\u0442 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0443\u0440\u043E\u043D\u0430 \u0437\u0430 \u0441\u0447\u0435\u0442 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u044F
      \u0441\u043D\u0430\u0440\u044F\u0434\u0430\n\n\u0412\u0440\u0430\u0433\u0438:
      \u041D\u0430\u0437\u0435\u043C\u043D\u044B\u0435"
    EngLocalization: 'Fires faster than the Simple Cannon.


      Upgrade: Deals
      more damage by increasing projectile size.


      Enemies: Ground'
    TurkLocalization: "Basit Toptan daha h\u0131zl\u0131 ate\u015F eder.\n\nY\u00FCkseltme:
      Mermi boyutunu art\u0131rarak daha fazla hasar verir.\n\nD\u00FC\u015Fmanlar:
      Kara"
  - Key: RocketLauncher
    RusLocalization: "\u0420\u0430\u043A\u0435\u0442\u043D\u0438\u0446\u0430"
    EngLocalization: Rocket Launcher
    TurkLocalization: Roketatar
  - Key: RocketLauncherDescription
    RusLocalization: "\u0421\u0442\u0440\u0435\u043B\u044F\u0435\u0442 \u0440\u0430\u043A\u0435\u0442\u0430\u043C\u0438
      \u043D\u0430\u043D\u043E\u0441\u044F \u0443\u0440\u043E\u043D \u043F\u043E
      \u043E\u0431\u043B\u0430\u0441\u0442\u0438\n\n\u0412\u0440\u0430\u0433\u0438:
      \u041D\u0430\u0437\u0435\u043C\u043D\u044B\u0435"
    EngLocalization: 'Fires rockets dealing area damage.


      Enemies: Ground'
    TurkLocalization: "Alan hasar\u0131 veren roketler atar.\n\nD\u00FC\u015Fmanlar:
      Kara"
  - Key: RocketLauncherUpgrade
    RusLocalization: "\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435 \u0434\u043B\u044F
      \u0440\u0430\u043A\u0435\u0442\u043D\u0438\u0446\u044B"
    EngLocalization: Rocket Launcher Upgrade
    TurkLocalization: "Roketatar Y\u00FCkseltmesi"
  - Key: RocketLauncherUpgradeDescription
    RusLocalization: "\u0421\u0442\u0440\u0435\u043B\u044F\u0435\u0442 \u0440\u0430\u043A\u0435\u0442\u0430\u043C\u0438
      \u043D\u0430\u043D\u043E\u0441\u044F \u0443\u0440\u043E\u043D \u043F\u043E
      \u043E\u0431\u043B\u0430\u0441\u0442\u0438\n\n\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435:
      \u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435 \u0440\u0430\u0434\u0438\u0443\u0441\u0430
      \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0438 \u0443\u0440\u043E\u043D\u0430\n\n\u0412\u0440\u0430\u0433\u0438:
      \u041D\u0430\u0437\u0435\u043C\u043D\u044B\u0435"
    EngLocalization: 'Fires rockets dealing area damage.


      Upgrade: Increases
      blast radius and damage.


      Enemies: Ground'
    TurkLocalization: "Alan hasar\u0131 veren roketler atar.\n\nY\u00FCkseltme: Patlama
      yar\u0131\u00E7ap\u0131n\u0131 ve hasar\u0131 art\u0131r\u0131r.\n\nD\u00FC\u015Fmanlar:
      Kara"
  - Key: FrostCannon
    RusLocalization: "\u041C\u043E\u0440\u043E\u0437\u043D\u0430\u044F \u043F\u0443\u0448\u043A\u0430"
    EngLocalization: Frost Cannon
    TurkLocalization: Buz Topu
  - Key: FrostCannonDescription
    RusLocalization: "\u0421\u0442\u0440\u0435\u043B\u044F\u0435\u0442 \u043C\u043E\u0440\u043E\u0437\u043E\u043C
      \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u044F \u0432\u0440\u0430\u0433\u043E\u0432\n\n\u0412\u0440\u0430\u0433\u0438:
      \u041D\u0430\u0437\u0435\u043C\u043D\u044B\u0435"
    EngLocalization: 'Fires frost slowing down enemies.


      Enemies: Ground'
    TurkLocalization: "D\u00FC\u015Fmanlar\u0131 yava\u015Flatan buz atar.\n\nD\u00FC\u015Fmanlar:
      Kara"
  - Key: FrostCannonUpgrade
    RusLocalization: "\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0430\u044F \u043C\u043E\u0440\u043E\u0437\u043D\u043E\u0439
      \u043F\u0443\u0448\u043A\u0438"
    EngLocalization: Frost Cannon Upgrade
    TurkLocalization: "Buz Topu Y\u00FCkseltmesi"
  - Key: FrostCannonUpgradeDescription
    RusLocalization: "\u0421\u0442\u0440\u0435\u043B\u044F\u0435\u0442 \u043C\u043E\u0440\u043E\u0437\u043E\u043C
      \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u044F \u0432\u0440\u0430\u0433\u043E\u0432\n\n\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435:
      \u0417\u0430\u043C\u0435\u0434\u043B\u044F\u0435\u0442 \u0432\u0440\u0430\u0433\u043E\u0432
      \u043D\u0430 \u0431\u043E\u043B\u0435\u0435 \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F\n\n\u0412\u0440\u0430\u0433\u0438: \u041D\u0430\u0437\u0435\u043C\u043D\u044B\u0435"
    EngLocalization: 'Fires frost slowing down enemies.


      Upgrade: Slows enemies
      for a longer duration.


      Enemies: Ground'
    TurkLocalization: "D\u00FC\u015Fmanlar\u0131 yava\u015Flatan buz atar.\n\nY\u00FCkseltme:
      D\u00FC\u015Fmanlar\u0131 daha uzun s\u00FCre yava\u015Flat\u0131r.\n\nD\u00FC\u015Fmanlar:
      Kara"
  - Key: LaserCannon
    RusLocalization: "\u041B\u0430\u0437\u0435\u0440\u043D\u0430\u044F \u043F\u0443\u0448\u043A\u0430"
    EngLocalization: Laser Cannon
    TurkLocalization: Lazer Topu
  - Key: LaserCannonDescription
    RusLocalization: "\u041F\u0440\u0438 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0435\u043D\u0438\u0438
      \u0432\u0440\u0430\u0433\u043E\u0432 \u0432\u044B\u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F
      \u043B\u0430\u0437\u0435\u0440, \u0432\u0440\u0430\u0449\u0430\u044F\u0441\u044C
      \u043D\u0430\u043D\u043E\u0441\u044F \u0443\u0440\u043E\u043D \u0432\u0440\u0430\u0433\u0430\u043C\n\n\u0412\u0440\u0430\u0433\u0438:
      \u041D\u0430\u0437\u0435\u043C\u043D\u044B\u0435"
    EngLocalization: 'When enemies approach, a laser extends and rotates dealing
      damage to enemies.


      Enemies: Ground'
    TurkLocalization: "D\u00FC\u015Fmanlar yakla\u015Ft\u0131\u011F\u0131nda lazer
      uzar ve d\u00F6nerek hasar verir.\n\nD\u00FC\u015Fmanlar: Kara"
  - Key: LaserCannonUpgrade
    RusLocalization: "\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435 \u0434\u043B\u044F
      \u043B\u0430\u0437\u0435\u0440\u043D\u043E\u0439 \u043F\u0443\u0448\u043A\u0438"
    EngLocalization: Laser Cannon Upgrade
    TurkLocalization: "Lazer Topu Y\u00FCkseltmesi"
  - Key: LaserCannonUpgradeDescription
    RusLocalization: "\u041F\u0440\u0438 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0435\u043D\u0438\u0438
      \u0432\u0440\u0430\u0433\u043E\u0432 \u0432\u044B\u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F
      \u043B\u0430\u0437\u0435\u0440, \u0432\u0440\u0430\u0449\u0430\u044F\u0441\u044C
      \u043D\u0430\u043D\u043E\u0441\u044F \u0443\u0440\u043E\u043D \u0432\u0440\u0430\u0433\u0430\u043C\n\n\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435:
      \u0414\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0432\u0442\u043E\u0440\u043E\u0433\u043E
      \u043B\u0430\u0437\u0435\u0440\u0430\n\n\u0412\u0440\u0430\u0433\u0438: \u041D\u0430\u0437\u0435\u043C\u043D\u044B\u0435"
    EngLocalization: 'When enemies approach, a laser extends and rotates dealing
      damage to enemies.


      Upgrade: Adds a second laser.


      Enemies: Ground'
    TurkLocalization: "D\u00FC\u015Fmanlar yakla\u015Ft\u0131\u011F\u0131nda lazer
      uzar ve d\u00F6nerek hasar verir.\n\nY\u00FCkseltme: \u0130kinci bir lazer
      ekler.\n\nD\u00FC\u015Fmanlar: Kara"
  - Key: LaserTurret
    RusLocalization: "\u041B\u0430\u0437\u0435\u0440\u043D\u0430\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430"
    EngLocalization: Laser Turret
    TurkLocalization: Lazer Kulesi
  - Key: LaserTurretDescription
    RusLocalization: "\u0421\u0442\u0440\u0435\u043B\u044F\u0435\u0442 \u043B\u0430\u0437\u0435\u0440\u043E\u043C,
      \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u043B\u0435\u0442\u0430\u043B\u044C\u043D\u044B\u0439
      \u0443\u0440\u043E\u043D. \u041E\u0447\u0435\u043D\u044C \u0434\u043E\u043B\u0433\u0430\u044F
      \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430\n\n\u0412\u0440\u0430\u0433\u0438:
      \u041D\u0430\u0437\u0435\u043C\u043D\u044B\u0435, \u043B\u0435\u0442\u0430\u044E\u0449\u0438\u0435"
    EngLocalization: 'Fires a laser dealing lethal damage. Very long reload time.


      Enemies:
      Ground, Flying'
    TurkLocalization: "Lazer atar, \u00F6l\u00FCmc\u00FCl hasar verir. \u00C7ok uzun
      yeniden y\u00FCkleme s\u00FCresi.\n\nD\u00FC\u015Fmanlar: Kara, Hava"
  - Key: LaserTurretUpgrade
    RusLocalization: "\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435 \u0434\u043B\u044F
      \u043B\u0430\u0437\u0435\u0440\u043D\u043E\u0439 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438"
    EngLocalization: Laser Turret Upgrade
    TurkLocalization: "Lazer Kulesi Y\u00FCkseltmesi"
  - Key: LaserTurretUpgradeDescription
    RusLocalization: "\u0421\u0442\u0440\u0435\u043B\u044F\u0435\u0442 \u043B\u0430\u0437\u0435\u0440\u043E\u043C,
      \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u043B\u0435\u0442\u0430\u043B\u044C\u043D\u044B\u0439
      \u0443\u0440\u043E\u043D. \u041E\u0447\u0435\u043D\u044C \u0434\u043E\u043B\u0433\u0430\u044F
      \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430  \n\n\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435:
      \u041D\u0430\u043D\u043E\u0441\u0438\u0442 \u0443\u0440\u043E\u043D \u0434\u0432\u043E\u0438\u043C
      \u0432\u0440\u0430\u0433\u0430\u043C  \n\n\u0412\u0440\u0430\u0433\u0438: \u041D\u0430\u0437\u0435\u043C\u043D\u044B\u0435,
      \u043B\u0435\u0442\u0430\u044E\u0449\u0438\u0435"
    EngLocalization: 'Fires a laser dealing lethal damage. Very long reload time.


      Upgrade:
      Deals damage to two enemies at once.


      Enemies: Ground, Flying'
    TurkLocalization: "Lazer atar, \u00F6l\u00FCmc\u00FCl hasar verir. \u00C7ok uzun
      yeniden y\u00FCkleme s\u00FCresi.\n\nY\u00FCkseltme: Ayn\u0131 anda iki d\u00FC\u015Fmana
      hasar verir.\n\nD\u00FC\u015Fmanlar: Kara, Hava"
  - Key: Rocket
    RusLocalization: "\u0420\u0430\u043A\u0435\u0442\u0430"
    EngLocalization: Rocket
    TurkLocalization: Roket
  - Key: RocketDescription
    RusLocalization: "\u041F\u043E\u0441\u043B\u0435 \u043D\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u044F
      \u043B\u0435\u0442\u0438\u0442 \u043A \u0446\u0435\u043B\u0438 \u0438 \u043F\u0440\u0438
      \u0432\u0437\u0440\u044B\u0432\u0435 \u043D\u0430\u043D\u043E\u0441\u0438\u0442
      \u0443\u0440\u043E\u043D \u043F\u043E \u043E\u0431\u043B\u0430\u0441\u0442\u0438"
    EngLocalization: After locking on, flies toward the target and deals area damage
      upon explosion.
    TurkLocalization: "Hedef kilitlenince hedefe u\u00E7ar ve patlamada alan hasar\u0131
      verir."
  - Key: Mine
    RusLocalization: "\u041C\u0438\u043D\u0430"
    EngLocalization: Mine
    TurkLocalization: "May\u0131n"
  - Key: MineDescription
    RusLocalization: "\u041F\u0440\u0438 \u0441\u043E\u043F\u0440\u0438\u043A\u043E\u0441\u043D\u043E\u0432\u0435\u043D\u0438\u0438
      \u0441 \u0432\u0440\u0430\u0433\u043E\u043C \u0432\u0437\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430\u043D\u043E\u0441\u044F \u0443\u0440\u043E\u043D \u043F\u043E
      \u043E\u0431\u043B\u0430\u0441\u0442\u0438"
    EngLocalization: Explodes upon contact with an enemy, dealing area damage.
    TurkLocalization: "D\u00FC\u015Fmanla temas etti\u011Finde patlar ve alan hasar\u0131
      verir."
  - Key: MeteorShower
    RusLocalization: "\u041C\u0435\u0442\u0435\u043E\u0440\u0438\u0442\u043D\u044B\u0439
      \u0434\u043E\u0436\u0434\u044C"
    EngLocalization: Meteor Shower
    TurkLocalization: "Meteor Ya\u011Fmuru"
  - Key: MeteorShowerDescription
    RusLocalization: "\u041D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u043C\u0435\u0442\u0435\u043E\u0440\u0438\u0442\u043D\u044B\u0439
      \u0434\u043E\u0436\u0434\u044C \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0430\u043D\u043E\u0441\u0438\u0442
      \u0443\u0440\u043E\u043D \u0432\u0440\u0430\u0433\u0430\u043C \u043F\u043E
      \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u0442\u0430\u043A \u0436\u0435
      \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u0443\u0440\u043E\u043C \u0431\u0430\u0448\u043D\u044F\u043C"
    EngLocalization: Starts a meteor shower dealing area damage to enemies, also
      damages towers.
    TurkLocalization: "D\u00FC\u015Fmanlara alan hasar\u0131 veren bir meteor ya\u011Fmuru
      ba\u015Flat\u0131r, ayn\u0131 zamanda kulelere de hasar verir."
  - Key: Wallet
    RusLocalization: "\u041A\u043E\u0448\u0435\u043B\u0435\u043A"
    EngLocalization: Wallet
    TurkLocalization: "C\u00FCzdan"
  - Key: WalletDescription
    RusLocalization: "\u0414\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 10 \u043C\u043E\u043D\u0435\u0442
      \u0434\u043B\u044F \u043F\u043E\u043A\u0443\u043F\u043A\u0438 \u0438 \u0430\u043F\u0433\u0440\u0435\u0439\u0434\u0430
      \u0431\u0430\u0448\u0435\u043D"
    EngLocalization: Adds 10 coins for purchasing and upgrading towers.
    TurkLocalization: "Kule sat\u0131n alma ve y\u00FCkseltme i\u00E7in 10 alt\u0131n
      ekler."
  - Key: HealthPack
    RusLocalization: "\u0425\u0438\u043B\u043A\u0430"
    EngLocalization: Health Pack
    TurkLocalization: "Sa\u011Fl\u0131k Paketi"
  - Key: HealthPackDescription
    RusLocalization: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0447\u0430\u0441\u0442\u044C \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F
      \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u0438"
    EngLocalization: Restores a portion of the fortress health.
    TurkLocalization: "Kalenin sa\u011Fl\u0131\u011F\u0131n\u0131n bir k\u0131sm\u0131n\u0131
      yeniler."
  LocalizationBoxesTowers:
  - Key: TargetsGroundAir
    RusLocalization: "\u0426\u0435\u043B\u0438: \u041D\u0430\u0437\u0435\u043C\u043D\u044B\u0435,
      \u043B\u0435\u0442\u0430\u044E\u0449\u0438\u0435"
    EngLocalization: 'Targets: Ground, Air'
    TurkLocalization: "Hedefler: Kara, Hava"
  - Key: TargetsGround
    RusLocalization: "\u0426\u0435\u043B\u0438: \u041D\u0430\u0437\u0435\u043C\u043D\u044B\u0435"
    EngLocalization: 'Targets: Ground'
    TurkLocalization: "Hedefler: Kara"
